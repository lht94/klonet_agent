# klone 记忆生命周期 Worker 的环境文件样例。
# 复制到 /etc/klonet/memory-maintenance.env 并 chmod 600。
# **值全是占位**——真实凭据由运维填写，绝不入库/入 git。

# 记忆库连接（klonet_maint 是 0006 授予的最小权限角色：只写 memory_maintenance.*）
KLONET_AGENT_MEMORY_DSN=postgresql://klonet_maint:CHANGE_ME@127.0.0.1:5432/klonet_memory

# Worker 开关与节奏（MaintenanceConfig；非法值拒绝启动，不静默修正）
KLONET_AGENT_MAINTENANCE_ENABLED=true
KLONET_AGENT_MAINTENANCE_POLL_SECONDS=5
KLONET_AGENT_MAINTENANCE_LEASE_SECONDS=120
KLONET_AGENT_MAINTENANCE_SHUTDOWN_GRACE_SECONDS=30

# purge 的保留期（合规下限见 memory/admin.RetentionPolicy.compliance_floor_days）
KLONET_AGENT_MEMORY_RETENTION_DAYS=30

# 日志
PYTHONUNBUFFERED=1
